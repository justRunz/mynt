{
  "name": "mynt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @mynt/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d && dbmate --wait up && pnpm db:password",
    "db:down": "docker compose down",
    "db:new": "dbmate new",
    "db:migrate": "dbmate --wait up",
    "db:catalog": "docker exec mynt_db psql -U postgres -d mynt -qc \"select extend_catalog(extract(year from now())::int)\"",
    "db:demo": "node scripts/seed-demo.mjs",
    "db:password": "docker exec mynt_db psql -U postgres -qc \"alter role mynt_app password 'mynt'\"",
    "db:status": "dbmate status",
    "db:reset": "dbmate --wait drop && dbmate up",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.0",
    "dbmate": "^2.35.1",
    "supabase": "^2.116.0",
    "typescript": "catalog:"
  }
}
