{
  "name": "mynt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "pnpm --filter @mynt/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.116.0",
    "typescript": "catalog:"
  }
}
