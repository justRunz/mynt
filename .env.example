# The database, for the tools that manage it: dbmate, which looks for this file
# at the repo root, and the test suite, which also loads apps/backend/.env.
#
# Local development only. The server's own settings live in apps/backend/.env,
# the front end's in apps/web/.env.local -- one file per thing that reads it, as
# they will be in production, where Dokploy hands each container its own.

# sslmode=disable because the container speaks plain TCP on the loopback
# interface; without it the driver refuses to connect.
DATABASE_URL=postgres://postgres:mynt@127.0.0.1:5433/mynt?sslmode=disable

# The suite runs against its own database so a test run cannot truncate the
# collection open in the browser. Two roles, and the distinction is the whole
# point of the isolation test:
#
#   the owner sets the fixture up -- creating accounts needs privileges the
#   server does not have, and bypassing the policies is what a fixture is for;
#
#   mynt_app is what the code under test connects as. Pointing the test at the
#   owner instead would make it pass while proving nothing, since an owner
#   bypasses row level security entirely.
TEST_DATABASE_URL=postgres://postgres:mynt@127.0.0.1:5433/mynt_test?sslmode=disable
TEST_APP_DATABASE_URL=postgres://mynt_app:mynt@127.0.0.1:5433/mynt_test?sslmode=disable

# dbmate writes db/schema.sql after every migration, which needs a pg_dump on
# the host matching the server's major version. There is none here, and at this
# size the migrations are already the readable description of the schema.
DBMATE_NO_DUMP_SCHEMA=true
