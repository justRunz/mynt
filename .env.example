# Copy to .env. Read by dbmate, which looks for this file at the repo root.
#
# Local development only. The hosted database takes its URL from Dokploy's
# environment, and this file is never deployed.

# sslmode=disable because the container speaks plain TCP on the loopback
# interface; without it the driver refuses to connect.
DATABASE_URL=postgres://postgres:mynt@127.0.0.1:5433/mynt?sslmode=disable

# What the Express server connects as. Owns nothing, so row level security
# applies to it in full -- unlike the URL above, which is the owner and would
# bypass every policy without a word.
APP_DATABASE_URL=postgres://mynt_app:mynt@127.0.0.1:5433/mynt?sslmode=disable

# The suite runs against its own database so a test run cannot truncate the
# collection open in the browser.
TEST_DATABASE_URL=postgres://postgres:mynt@127.0.0.1:5433/mynt_test?sslmode=disable

# dbmate writes db/schema.sql after every migration, which needs a pg_dump on
# the host matching the server's major version. There is none here, and at this
# size the migrations are already the readable description of the schema.
DBMATE_NO_DUMP_SCHEMA=true
