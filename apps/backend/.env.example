# The server's settings, and nothing else. Read by `pnpm dev` and `pnpm start`
# in apps/backend, and by the test suite alongside the root .env.
#
# The database's own tooling lives in the root .env. APP_DATABASE_URL is here
# rather than there because it is how the server connects, not how the schema is
# managed -- which means a changed port has to be changed in both files.

# What the Express server connects as. Owns nothing, so row level security
# applies to it in full -- unlike the URL above, which is the owner and would
# bypass every policy without a word.
APP_DATABASE_URL=postgres://mynt_app:mynt@127.0.0.1:5433/mynt?sslmode=disable

# Where the app is served from. CORS allows it in development, and every link in
# an email is built from it -- so in production this is the real domain, not a
# localhost left over from a template.
APP_URL=http://localhost:5173

# Where mail goes. Mailpit locally: it accepts everything, delivers nothing, and
# shows the messages at http://localhost:8025. mynt.local is not a real domain,
# which is fine because nothing leaves the machine.
#
# Production is Resend, and the only difference is these five lines:
#
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend            <- the literal word, not a placeholder
#   SMTP_PASSWORD=<api key>
#   MAIL_FROM=Mynt <no-reply@the-real-domain>
#
# 587 rather than 465 puts the transport on STARTTLS, which is the branch
# secure: port === 465 already covers. No code changes for either.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Mynt <no-reply@mynt.local>
PORT=3001

# What the server signs its own access tokens with. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
