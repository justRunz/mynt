{
  "name": "@mynt/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch-path=. --env-file=.env src/server.ts",
    "start": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "build": "echo \"@mynt/backend runs from source with tsx, nothing to build\"",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mynt/core": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jose": "^6.2.17",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
